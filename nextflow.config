manifest {
  name            = 'nf-austin/echidna'
  author          = 'Austin Varela'
  homePage        = 'https://github.com/nf-austin/echidna'
  description     = 'Bayesian gene dosage inference from scRNA-seq and (optionally) bulk WGS copy number'
  mainScript      = 'main.nf'
  nextflowVersion = '>=24.04.0'
  version         = '0.1.0'
  defaultBranch   = 'main'
}

params {
  // Input -- choose one mode:
  // Auto-discovery: point at nf-austin/scrnaseq and nf-austin/wgs-cna output dirs
  scrna_dir  = null   // {scrna_dir}/{sample_id}/{sample_id}_annotated.h5ad
  wgs_dir    = null   // {wgs_dir}/{sample_id}.seg.txt  (optional; null = no-WGS mode for all samples)
  sample_map = null   // CSV (scrna_sample,wgs_sample) bridging mismatched naming conventions
  // Explicit samplesheet (multi-timepoint or custom): CSV with columns sample,h5ad,seg_txt.
  // This is the mode Seqera Platform launches with (nextflow_schema.json gives
  // it a file picker).
  input      = null

  outdir   = "results"
  help     = false
  genome   = 'hg38'  // UCSC genome name used for auto-download of refGene BED
  gene_bed = null    // override auto-download: path to existing BED (chr,start,end,gene_name).
                     // Prefer this on HPC -- compute nodes often have no outbound network.

  // Pre-processing
  num_genes    = null
  n_comps      = 15
  phenograph_k = 60
  n_neighbors  = 15

  // Training (EchidnaConfig)
  timepoint_label = "timepoint"
  counts_layer    = "counts"
  clusters        = "pheno_leiden"
  n_steps         = 10000
  learning_rate   = 0.1
  val_split       = 0.1
  patience        = null
  seed            = 42
  inverse_gamma   = false  // set true when running without WGS (more flexible eta variance)

  // CNV inference (echi_cnv)
  n_hmm_components   = 5
  n_gmm_components   = 5
  gaussian_smoothing = true
  filter_quantile    = 0.7
  smoother_sigma     = 6
  smoother_radius    = 8  // must be a non-negative integer (passed to scipy gaussian_filter1d)
  neut_method        = "peak"

  // Tumor cell calling (call_tumor_cells)
  call_tumor_cells             = false  // opt-in: derive aneuploid/diploid calls + CIN diversity index from echi_cnv output
  tumor_frac_altered_threshold = 0.05   // clone-level non-neutral gene fraction above which a clone is called aneuploid

  // Container image, published to GHCR by .github/workflows/docker.yml. Pinned
  // rather than :latest so runs stay reproducible; bump alongside
  // manifest.version. One image serves every process -- the run_echidna stack is
  // a superset of what the other steps need.
  echidna_container = "ghcr.io/nf-austin/echidna:0.1.0"

  // Resource caps (applied via process.resourceLimits below). Use Nextflow
  // unit literals (.GB, .h) so values stay typed as MemoryUnit / Duration.
  max_memory        = 128.GB
  max_cpus          = 32
  max_time          = 72.h
  max_forks_echidna = 1  // concurrent RUN_ECHIDNA jobs; increase if the GPU has headroom

  // Execution environment. Used by the `slurm` profile; ignored otherwise.
  // Seqera Platform's own SLURM compute environment sets the executor itself,
  // so the profile is mainly for launching by hand from a login node.
  slurm_queue     = null   // sbatch --partition
  slurm_account   = null   // sbatch --account
  cluster_options = null   // raw sbatch options, e.g. '--qos=long' or '--gres=gpu:1'

  // Caches. Left null so NXF_SINGULARITY_CACHEDIR / NXF_CONDA_CACHEDIR or an
  // explicit flag wins, and Nextflow's own $NXF_HOME default applies otherwise.
  // Point these at shared storage on a cluster: $HOME is quota-limited and not
  // always mounted on compute nodes. Never at ${projectDir} -- on a Platform
  // launch that is a fresh scratch clone per run, so nothing would ever cache.
  singularity_cache_dir = null
  conda_cache_dir       = null

  // Extra Singularity bind mounts. autoMounts only binds paths Nextflow has
  // resolved, and HPC filesystems are routinely symlinked (/data -> /mnt/gpfs/..),
  // which surfaces as "file not found" inside the container despite the host
  // path existing. Comma-separated, e.g. '/mnt/gpfs,/scratch'.
  singularity_bind = null
}

process {
  // Nextflow 24.04+ enforces these caps automatically on every task.
  resourceLimits = [
    memory: params.max_memory,
    cpus  : params.max_cpus,
    time  : params.max_time
  ]

  withName: 'DOWNLOAD_GENE_BED' {
    cpus          = 1
    memory        = { workflow.stubRun ? 1.GB : 2.GB * task.attempt }
    time          = { workflow.stubRun ? 10.m : 30.m * task.attempt }
    errorStrategy = 'retry'
    maxRetries    = 2
  }

  withName: 'SEG_TO_GENE_CN' {
    cpus          = 2
    memory        = { workflow.stubRun ? 1.GB : 8.GB * task.attempt }
    time          = { workflow.stubRun ? 10.m : 1.h * task.attempt }
    errorStrategy = 'retry'
    maxRetries    = 2
  }

  withName: 'RUN_ECHIDNA' {
    maxForks      = params.max_forks_echidna
    // -stub-run touches no data, so it must not demand a big node -- otherwise
    // validating the wiring fails on a laptop with "Process requirement exceeds
    // available CPUs".
    cpus          = { workflow.stubRun ? 1    : 8 * task.attempt }
    memory        = { workflow.stubRun ? 1.GB : 64.GB * task.attempt }
    time          = { workflow.stubRun ? 10.m : 24.h * task.attempt }
    errorStrategy = 'retry'
    maxRetries    = 2
  }

  withName: 'CALL_TUMOR_CELLS' {
    cpus          = 2
    memory        = { workflow.stubRun ? 1.GB : 8.GB }
    time          = { workflow.stubRun ? 10.m : 30.m }
    errorStrategy = 'retry'
    maxRetries    = 2
  }

  withName: 'CONCAT_H5ADS' {
    cpus          = { workflow.stubRun ? 1    : 4 * task.attempt }
    memory        = { workflow.stubRun ? 1.GB : 16.GB * task.attempt }
    time          = { workflow.stubRun ? 10.m : 2.h * task.attempt }
    errorStrategy = 'retry'
    maxRetries    = 2
  }
}

// Execution reports. Seqera Platform renders these, and they are the first
// thing to look at when a run misbehaves. overwrite so -resume does not fail on
// a pre-existing file.
report {
  enabled   = true
  overwrite = true
  file      = "${params.outdir}/pipeline_info/execution_report.html"
}
timeline {
  enabled   = true
  overwrite = true
  file      = "${params.outdir}/pipeline_info/execution_timeline.html"
}
trace {
  enabled   = true
  overwrite = true
  file      = "${params.outdir}/pipeline_info/execution_trace.txt"
}
dag {
  enabled   = true
  overwrite = true
  file      = "${params.outdir}/pipeline_info/pipeline_dag.html"
}

profiles {
  // Executor only -- deliberately touches no container-engine setting, so its
  // key set stays disjoint from the engine profiles below and
  // `-profile slurm,singularity` composes in either order.
  // A null queue/clusterOptions emits no sbatch flag at all (verified on 26.04),
  // so these are safe to assign unconditionally -- which matters, because
  // `nextflow lint` rejects an `if` statement inside a config block.
  slurm {
    process.executor       = 'slurm'
    process.queue          = params.slurm_queue
    process.clusterOptions = params.cluster_options
  }
  docker {
    docker.enabled      = true
    // userEmulation was removed in Nextflow 24.x; fixOwnership replaces it.
    docker.fixOwnership = true
    singularity.enabled = false
    conda.enabled       = false
  }
  singularity {
    singularity.enabled    = true
    singularity.autoMounts = true
    singularity.cacheDir   = params.singularity_cache_dir
    singularity.runOptions = params.singularity_bind ? "-B ${params.singularity_bind}" : null
    docker.enabled         = false
    conda.enabled          = false
  }
  conda {
    // Every module ships an environment.yml as well as a container, so
    // conda-only mode is a real fallback here (unlike nf-austin/valis).
    conda.enabled       = true
    conda.cacheDir      = params.conda_cache_dir
    docker.enabled      = false
    singularity.enabled = false
  }
}
